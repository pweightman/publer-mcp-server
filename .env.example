# Required: Publer API key.
# Generate one in Publer under Settings -> Access & Login -> API Keys.
# Requires an Enterprise plan, or a Business plan in good standing.
PUBLER_API_KEY=your_api_key_here

# Optional: default workspace ID applied to workspace-scoped requests.
# Most tools also accept a workspace_id argument that overrides this.
# Discover IDs with the publer_list_workspaces tool.
PUBLER_WORKSPACE_ID=

# Optional: override the API base URL (defaults to https://app.publer.com/api/v1).
PUBLER_API_BASE_URL=
